/.lake

# Generated by leanblueprint/plasTeX — regenerated by `lake build :blueprint`
# and `leanblueprint web/pdf`. Don't commit; CI deployment is the place to
# rebuild these.
blueprint/web/
blueprint/print/
blueprint/lean_decls
blueprint/src/*.paux
blueprint/src/*.aux
blueprint/src/*.log
blueprint/src/*.out
blueprint/src/*.toc

# Per-sprint .lean snapshots for the web-agent handoff. Generated alongside
# `notes/N-slug.md`; never tracked in git.
exports/*.zip

# doc-gen4 builds inside the nested `docbuild/` project. Track only its
# `lakefile.toml`, `lake-manifest.json`, and `lean-toolchain`; never the
# build cache.
docbuild/.lake/

# macOS Finder metadata.
.DS_Store
